# Google OAuth secrets
# Supply these at runtime. Never commit the real values or bake them into an image.
GOOGLE_HEALTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_HEALTH_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Google OAuth and read-only scope policy
# This redirect URI must match the Google Cloud OAuth client configuration.
GOOGLE_HEALTH_REDIRECT_URI=http://127.0.0.1:3000/callback
GOOGLE_HEALTH_SCOPES=https://www.googleapis.com/auth/googlehealth.profile.readonly https://www.googleapis.com/auth/googlehealth.settings.readonly https://www.googleapis.com/auth/googlehealth.activity_and_fitness.readonly https://www.googleapis.com/auth/googlehealth.health_metrics_and_measurements.readonly https://www.googleapis.com/auth/googlehealth.sleep.readonly https://www.googleapis.com/auth/googlehealth.nutrition.readonly

# Ordinary runtime configuration
GOOGLE_HEALTH_MCP_TRANSPORT=http
GOOGLE_HEALTH_MCP_HOST=0.0.0.0
GOOGLE_HEALTH_MCP_PORT=3000
GOOGLE_HEALTH_PRIVACY_MODE=structured

# Keep persistent SQLite caching disabled. Leave GOOGLE_HEALTH_NO_CACHE unset so
# the existing default in-memory HTTP cache remains available for GET requests.
GOOGLE_HEALTH_CACHE=false

# Persistent OAuth state. Mount this directory from the host or a named volume.
GOOGLE_HEALTH_TOKEN_PATH=/home/node/.google-health-mcp/tokens.json

# Optional browser-client CORS restriction. Server-to-server MCP clients do not
# normally need this setting; set it only to the intended client origin.
# GOOGLE_HEALTH_MCP_ALLOWED_ORIGIN=https://your-client.example

# Cloudflare Access is opt-in at the origin. Enable it only after the Access
# application and audience are configured; /health remains unauthenticated.
GOOGLE_HEALTH_MCP_CLOUDFLARE_ACCESS_REQUIRED=false
# GOOGLE_HEALTH_MCP_CLOUDFLARE_ACCESS_REQUIRED=true
# GOOGLE_HEALTH_MCP_CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# GOOGLE_HEALTH_MCP_CLOUDFLARE_ACCESS_AUD=replace-with-cloudflare-access-audience-tag
